# ============================================================================
# NOLHAN OS — variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs.
# NE JAMAIS committer `.env`. Aucune valeur réelle/secrète ne doit figurer ici.
# ============================================================================

# --- Base de données (OBLIGATOIRE) -----------------------------------------
# URL PostgreSQL. En local avec docker compose :
# postgresql://nolhan:nolhan@localhost:5432/nolhan_os?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nolhan_os?schema=public"

# --- Application (OBLIGATOIRE) ---------------------------------------------
# URL publique du site (sans slash final). Ex : https://os.mondomaine.ch
APP_URL="http://localhost:3000"

# Secret de signature des sessions Auth.js (min. 32 caractères).
# Générer : openssl rand -base64 32
AUTH_SECRET=""

# Auth.js : faire confiance à l'en-tête Host (nécessaire derrière un reverse proxy).
AUTH_TRUST_HOST="true"

# Clé de chiffrement AES-256-GCM des données sensibles (emails/téléphones clients,
# tokens OAuth). EXACTEMENT 32 octets encodés en base64.
# Générer : openssl rand -base64 32
# ⚠️ La perte de cette clé rend les données chiffrées illisibles. La sauvegarder.
ENCRYPTION_KEY=""

# Autoriser les nouvelles inscriptions (true/false). Mettre false en production
# une fois ton compte créé.
ALLOW_REGISTRATION="true"

# --- Logs --------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="info"

# --- Imports -----------------------------------------------------------------
# Taille maximale d'un fichier d'import Planity (Mo). Défaut : 5
IMPORT_MAX_FILE_MB="5"

# --- Intelligence artificielle (OPTIONNEL) ---------------------------------
# none | anthropic | openai
# "none" : le coach fonctionne en mode déterministe (règles + données réelles).
AI_PROVIDER="none"
# Clé API Anthropic (console.anthropic.com → API Keys). Requis si AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=""
# Clé API OpenAI (platform.openai.com → API keys). Requis si AI_PROVIDER=openai.
OPENAI_API_KEY=""
# Modèle utilisé par le fournisseur (laisser vide = valeur par défaut du provider).
AI_MODEL=""

# --- Instagram (OPTIONNEL — voir docs/INSTAGRAM.md) -------------------------
# Laisser vide tant que l'application Meta n'est pas configurée :
# le statut restera "Configuration required".
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""

# --- TikTok (OPTIONNEL — voir docs/TIKTOK.md) -------------------------------
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI=""

# --- Seed DEMO (OPTIONNEL, développement uniquement) ------------------------
# Compte créé par `npm run db:seed`. Ne pas utiliser en production.
SEED_DEMO_EMAIL="demo@nolhan-os.local"
SEED_DEMO_PASSWORD=""
